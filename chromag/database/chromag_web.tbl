-- one per ChroMag file available from the website/API

create table chromag_web (
  file_id                               int auto_increment primary key,
  dt_created                            timestamp default current_timestamp,
  filename                              varchar not null,
  l0_filename                           varchar not null,
  filesize                              int,   -- bytes

  date_obs                              datetime not null,
  obsday_id                             mediumint(5) not null,

  -- [TODO]: web specific information

  index (date_obs),
  index (obsday_id),
  unique(filename),

  foreign key (obsday_id) references mlso_numfiles(day_id)
);
